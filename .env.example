MYSQL_DATABASE=dev_pro
MYSQL_USER=devpro
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MYSQL_PORT=3306

SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:mysql://192.168.0.71:3306/dev_pro?useUnicode=true&characterEncoding=utf8mb4&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=devpro
SPRING_DATASOURCE_PASSWORD=change_me

VITE_API_BASE_URL=http://localhost:8080
BACKEND_PORT=8080
FRONTEND_PORT=80

# mihotel 缓存清理目标格式：编码|服务基础地址，多个目标用英文逗号分隔；展示名由后端按编码和端口生成，避免 .env 中文编码问题。
MIHOTEL_CLEAR_CACHE_TRUNK_TARGETS=trunk-8104|http://example.com:8104,trunk-8106|http://example.com:8106
MIHOTEL_CLEAR_CACHE_LOCAL_TARGETS=local-8080|http://localhost:8080
MIHOTEL_CLEAR_CACHE_READ_TIMEOUT_SECONDS=180

# mihotel 系统参数查询环境地址，由后端代理访问 mihotel 原有 /operations/findSysOptionByCode 接口。
MIHOTEL_SYSTEM_PARAM_TRUNK_BASE_URL=https://example.com
MIHOTEL_SYSTEM_PARAM_LOCAL_BASE_URL=http://localhost:8080
MIHOTEL_SYSTEM_PARAM_READ_TIMEOUT_SECONDS=60
